CREATE DATABASE foodwaste_db;
USE foodwaste_db;

CREATE TABLE food_waste (
    id INT AUTO_INCREMENT PRIMARY KEY,
    food_name VARCHAR(100) NOT NULL,
    quantity INT NOT NULL,
    location VARCHAR(100) NOT NULL,
    expiry_date DATE NOT NULL,
    status VARCHAR(50) NOT NULL
);


import javafx.application.Application;
import javafx.geometry.Insets;
import javafx.scene.Scene;
import javafx.scene.control.*;
import javafx.scene.layout.GridPane;
import javafx.stage.Stage;

import java.sql.*;

public class FoodWasteManagementApp extends Application {

    private Connection connection;

    private TextField idField = new TextField();
    private TextField foodNameField = new TextField();
    private TextField quantityField = new TextField();
    private TextField locationField = new TextField();
    private TextField expiryDateField = new TextField();
    private TextField statusField = new TextField();

    private TextArea displayArea = new TextArea();

    public static void main(String[] args) {
        launch(args);
    }

    @Override
    public void start(Stage primaryStage) {

        connectToDatabase();

        GridPane grid = new GridPane();
        grid.setPadding(new Insets(15));
        grid.setHgap(10);
        grid.setVgap(10);

        idField.setPromptText("ID");
        foodNameField.setPromptText("Food Name");
        quantityField.setPromptText("Quantity");
        locationField.setPromptText("Location");
        expiryDateField.setPromptText("Expiry Date YYYY-MM-DD");
        statusField.setPromptText("Status");

        Button createButton = new Button("Add Food");
        Button readButton = new Button("Display");
        Button updateButton = new Button("Update");
        Button deleteButton = new Button("Delete");

        createButton.setOnAction(e -> createFood());
        readButton.setOnAction(e -> readFood());
        updateButton.setOnAction(e -> updateFood());
        deleteButton.setOnAction(e -> deleteFood());

        grid.add(new Label("ID:"), 0, 0);
        grid.add(idField, 1, 0);

        grid.add(new Label("Food Name:"), 0, 1);
        grid.add(foodNameField, 1, 1);

        grid.add(new Label("Quantity:"), 0, 2);
        grid.add(quantityField, 1, 2);

        grid.add(new Label("Location:"), 0, 3);
        grid.add(locationField, 1, 3);

        grid.add(new Label("Expiry Date:"), 0, 4);
        grid.add(expiryDateField, 1, 4);

        grid.add(new Label("Status:"), 0, 5);
        grid.add(statusField, 1, 5);

        grid.add(createButton, 0, 6);
        grid.add(readButton, 1, 6);
        grid.add(updateButton, 0, 7);
        grid.add(deleteButton, 1, 7);

        displayArea.setEditable(false);
        displayArea.setWrapText(true);

        grid.add(displayArea, 0, 8, 2, 1);

        Scene scene = new Scene(grid, 500, 600);

        primaryStage.setTitle("Online Food Waste Reduction System");
        primaryStage.setScene(scene);
        primaryStage.show();
    }

    private void connectToDatabase() {
        try {
            Class.forName("com.mysql.cj.jdbc.Driver");

            connection = DriverManager.getConnection(
                "jdbc:mysql://localhost:3306/foodwaste_db",
                "root",
                "1234"
            );

            System.out.println("Database connected successfully.");

        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    private void createFood() {

        String foodName = foodNameField.getText();
        int quantity = Integer.parseInt(quantityField.getText());
        String location = locationField.getText();
        String expiryDate = expiryDateField.getText();
        String status = statusField.getText();

        String sql =
            "INSERT INTO food_waste " +
            "(food_name, quantity, location, expiry_date, status) " +
            "VALUES (?, ?, ?, ?, ?)";

        try (PreparedStatement ps = connection.prepareStatement(sql)) {

            ps.setString(1, foodName);
            ps.setInt(2, quantity);
            ps.setString(3, location);
            ps.setDate(4, Date.valueOf(expiryDate));
            ps.setString(5, status);

            ps.executeUpdate();

            displayArea.setText(
                "Food record added successfully!"
            );

        } catch (SQLException e) {
            e.printStackTrace();
        }
    }

    private void readFood() {

        String sql = "SELECT * FROM food_waste";

        try (Statement stmt = connection.createStatement();
             ResultSet rs = stmt.executeQuery(sql)) {

            StringBuilder result = new StringBuilder();

            while (rs.next()) {

                result.append("ID: ")
                      .append(rs.getInt("id"))
                      .append("\nFood: ")
                      .append(rs.getString("food_name"))
                      .append("\nQuantity: ")
                      .append(rs.getInt("quantity"))
                      .append("\nLocation: ")
                      .append(rs.getString("location"))
                      .append("\nExpiry Date: ")
                      .append(rs.getDate("expiry_date"))
                      .append("\nStatus: ")
                      .append(rs.getString("status"))
                      .append("\n-------------------------\n");
            }

            displayArea.setText(result.toString());

        } catch (SQLException e) {
            e.printStackTrace();
        }
    }

    private void updateFood() {

        int id = Integer.parseInt(idField.getText());

        String foodName = foodNameField.getText();
        int quantity = Integer.parseInt(quantityField.getText());
        String location = locationField.getText();
        String expiryDate = expiryDateField.getText();
        String status = statusField.getText();

        String sql =
            "UPDATE food_waste SET " +
            "food_name=?, quantity=?, location=?, " +
            "expiry_date=?, status=? WHERE id=?";

        try (PreparedStatement ps = connection.prepareStatement(sql)) {

            ps.setString(1, foodName);
            ps.setInt(2, quantity);
            ps.setString(3, location);
            ps.setDate(4, Date.valueOf(expiryDate));
            ps.setString(5, status);
            ps.setInt(6, id);

            ps.executeUpdate();

            displayArea.setText(
                "Food record updated successfully!"
            );

        } catch (SQLException e) {
            e.printStackTrace();
        }
    }

    private void deleteFood() {

        int id = Integer.parseInt(idField.getText());

        String sql =
            "DELETE FROM food_waste WHERE id=?";

        try (PreparedStatement ps = connection.prepareStatement(sql)) {

            ps.setInt(1, id);

            ps.executeUpdate();

            displayArea.setText(
                "Food record deleted successfully!"
            );

        } catch (SQLException e) {
            e.printStackTrace();
        }
    }

    @Override
    public void stop() throws Exception {

        if (connection != null && !connection.isClosed()) {
            connection.close();
        }

        super.stop();
    }
}

